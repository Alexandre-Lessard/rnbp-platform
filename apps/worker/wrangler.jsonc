{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rnbp-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "rnbp-api-staging",
      "vars": {
        "NODE_ENV": "staging",
        "FRONTEND_URL": "https://staging.rnbp-platform.pages.dev",
        "API_URL": "https://rnbp-api-staging.alexandre-lessard92.workers.dev/api",
        "CORS_ORIGINS": "https://staging.rnbp-platform.pages.dev,http://localhost:5173",
        "FROM_EMAIL": "noreply@rnbp.ca",
        "FROM_NAME": "RNBP (staging)"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "rnbp-db-staging",
          "database_id": "1afb4d18-ffe3-4ac6-bbaa-0e68a6fcf1ad"
        }
      ],
      "r2_buckets": [
        {
          "binding": "UPLOADS",
          "bucket_name": "rnbp-uploads-staging"
        }
      ],
      "unsafe": {
        "bindings": [
          {
            "name": "GLOBAL_RATE_LIMITER",
            "type": "ratelimit",
            "namespace_id": "1001",
            "simple": { "limit": 100, "period": 60 }
          },
          {
            "name": "AUTH_RATE_LIMITER",
            "type": "ratelimit",
            "namespace_id": "1002",
            "simple": { "limit": 10, "period": 60 }
          }
        ]
      }
    },

    // Production.
    "production": {
      "name": "rnbp-api",
      // api.badgeid.ca stays as an alias during the return to RNBP (T28), for
      // anything still holding the old host; it goes once traffic has moved.
      "routes": [
        { "pattern": "api.rnbp.ca", "custom_domain": true },
        { "pattern": "api.badgeid.ca", "custom_domain": true }
      ],
      // Heartbeat to health-monitor (health.al-si.com): see utils/heartbeat.ts.
      "triggers": { "crons": ["*/5 * * * *"] },
      "vars": {
        "NODE_ENV": "production",
        "FRONTEND_URL": "https://rnbp.ca",
        "API_URL": "https://api.rnbp.ca/api",
        "CORS_ORIGINS": "https://rnbp.ca,https://www.rnbp.ca,https://badgeid.ca,https://www.badgeid.ca",
        "FROM_EMAIL": "noreply@rnbp.ca",
        "FROM_NAME": "RNBP"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "rnbp-db",
          "database_id": "2f0498ca-ae93-467d-8010-3b34a64c220d"
        }
      ],
      "r2_buckets": [
        {
          "binding": "UPLOADS",
          "bucket_name": "rnbp-uploads"
        }
      ],
      "unsafe": {
        "bindings": [
          {
            "name": "GLOBAL_RATE_LIMITER",
            "type": "ratelimit",
            "namespace_id": "2001",
            "simple": { "limit": 100, "period": 60 }
          },
          {
            "name": "AUTH_RATE_LIMITER",
            "type": "ratelimit",
            "namespace_id": "2002",
            "simple": { "limit": 10, "period": 60 }
          }
        ]
      }
    }
  }
}
