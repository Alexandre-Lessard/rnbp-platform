{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "badge-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "badge-api-staging",
      "vars": {
        "NODE_ENV": "staging",
        "FRONTEND_URL": "https://staging.badge-platform.pages.dev",
        "API_URL": "https://badge-api-staging.alexandre-lessard92.workers.dev/api",
        "CORS_ORIGINS": "https://staging.badge-platform.pages.dev,http://localhost:5173",
        "FROM_EMAIL": "noreply@rnbp.ca",
        "FROM_NAME": "RNBP (staging)"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "badge-db-staging",
          "database_id": "ef6af431-b45f-4e2b-a34e-0414a2b8b063"
        }
      ],
      "r2_buckets": [
        {
          "binding": "UPLOADS",
          "bucket_name": "badge-uploads-staging"
        }
      ],
      "unsafe": {
        "bindings": [
          {
            "name": "GLOBAL_RATE_LIMITER",
            "type": "ratelimit",
            "namespace_id": "1001",
            "simple": { "limit": 100, "period": 60 }
          },
          {
            "name": "AUTH_RATE_LIMITER",
            "type": "ratelimit",
            "namespace_id": "1002",
            "simple": { "limit": 10, "period": 60 }
          }
        ]
      }
    },

    // Production.
    "production": {
      "name": "badge-api",
      // api.badgeid.ca stays as an alias during the return to RNBP (T28), for
      // anything still holding the old host; it goes once traffic has moved.
      "routes": [
        { "pattern": "api.rnbp.ca", "custom_domain": true },
        { "pattern": "api.badgeid.ca", "custom_domain": true }
      ],
      // Heartbeat to health-monitor (health.al-si.com): see utils/heartbeat.ts.
      "triggers": { "crons": ["*/5 * * * *"] },
      "vars": {
        "NODE_ENV": "production",
        "FRONTEND_URL": "https://rnbp.ca",
        "API_URL": "https://api.rnbp.ca/api",
        "CORS_ORIGINS": "https://rnbp.ca,https://www.rnbp.ca,https://badgeid.ca,https://www.badgeid.ca",
        "FROM_EMAIL": "noreply@rnbp.ca",
        "FROM_NAME": "RNBP"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "badge-db",
          "database_id": "487a867c-f911-4ec2-b274-c9b6fb399655"
        }
      ],
      "r2_buckets": [
        {
          "binding": "UPLOADS",
          "bucket_name": "badge-uploads"
        }
      ],
      "unsafe": {
        "bindings": [
          {
            "name": "GLOBAL_RATE_LIMITER",
            "type": "ratelimit",
            "namespace_id": "2001",
            "simple": { "limit": 100, "period": 60 }
          },
          {
            "name": "AUTH_RATE_LIMITER",
            "type": "ratelimit",
            "namespace_id": "2002",
            "simple": { "limit": 10, "period": 60 }
          }
        ]
      }
    }
  }
}
